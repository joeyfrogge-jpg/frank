# FrankGPT — copy to .env only if you run a local backend.
# The website free path needs none of this (no GPU).

APP_NAME=FrankGPT
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
WEB_PORT=5173

# Default: free browser generator (10s / 20s / 30s, no GPU)
MODEL_PROVIDER=free
MODEL_ID=free-browser
MODEL_DIR=
OUTPUT_DIR=./data/generated
UPLOAD_DIR=./data/uploads
AUTH_ENABLED=false

# Optional backend (only if you deploy server/)
FRANK_PORT=8000
FRANK_PUBLIC_URL=http://localhost:8000
FRANK_CORS_ORIGINS=https://joeyfrogge-jpg.github.io,http://localhost:8000
FRANK_PROVIDER=none

# Optional Google (also set in apps/web config.js or Settings)
#GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# Optional local GPU model later — leave disabled for free path
#FRANK_WEIGHTS_DIR=
#FRANK_LOCAL_CMD=
