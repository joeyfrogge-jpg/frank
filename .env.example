# Copy to .env and `set -a; . ./.env; set +a` before running server/server.py
FRANK_PORT=8000
FRANK_PUBLIC_URL=http://localhost:8000          # used for Stripe return URLs
FRANK_CORS_ORIGINS=https://joeyfrogge-jpg.github.io,http://localhost:8000,https://localhost,capacitor://localhost

# --- Engine: none | local | replicate | selftest ---
FRANK_PROVIDER=none
# local (Path A: your GPU)
#FRANK_WEIGHTS_DIR=/models/Wan2.1-T2V-1.3B-Diffusers
#FRANK_LOCAL_CMD=python3 server/workers/wan_t2v.py --weights $FRANK_WEIGHTS_DIR --prompt-file {prompt_file} --seconds {seconds} --out {out}
#FRANK_LOCAL_I2V=0
#FRANK_CLIP_SECONDS=5
# replicate (Path B: your account)
#REPLICATE_API_TOKEN=r8_...
#FRANK_REPLICATE_MODEL=owner/model-name
#FRANK_REPLICATE_PROMPT_KEY=prompt
#FRANK_REPLICATE_IMAGE_KEY=image
#FRANK_REPLICATE_EXTRA={}

# --- Auth ---
#GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
#TWILIO_ACCOUNT_SID=AC...
#TWILIO_AUTH_TOKEN=...
#TWILIO_VERIFY_SID=VA...

# --- Billing (Stripe) ---
#STRIPE_SECRET_KEY=sk_live_...
#STRIPE_WEBHOOK_SECRET=whsec_...
#STRIPE_PRICE_PLUS=price_...
#STRIPE_PRICE_PREMIUM=price_...
#STRIPE_PRICE_PLATINUM=price_...

# --- Storage ---
#FRANK_DATA=/var/lib/frank
#FRANK_RETENTION_DAYS=14
#FRANK_STORAGE_CAP_MB=5000
#FRANK_TRUST_PROXY=1     # set when behind Cloudflare Tunnel / a reverse proxy
